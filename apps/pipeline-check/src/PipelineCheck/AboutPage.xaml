<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PipelineCheck.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <StackPanel MaxWidth="1000" Padding="36,24" Spacing="12">
      <TextBlock Text="About" AutomationProperties.AutomationId="AboutTitle"
                 AutomationProperties.HeadingLevel="Level1"
                 Style="{StaticResource TitleTextBlockStyle}" />
      <TextBlock x:Name="VersionText" AutomationProperties.AutomationId="VersionText"
                 Style="{StaticResource BodyTextBlockStyle}" />
      <TextBlock Text="Developed by Sushant Kumar" Style="{StaticResource BodyStrongTextBlockStyle}" />
      <HyperlinkButton Content="sushant.sare@gmail.com" NavigateUri="mailto:sushant.sare@gmail.com"
                       AutomationProperties.AutomationId="EmailLink" Padding="0" />
    </StackPanel>
  </ScrollViewer>
</Page>
