<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AppStore.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="App Store">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="Search_Invoked" />
      <KeyboardAccelerator Key="F5" Invoked="Refresh_Invoked" />
    </Grid.KeyboardAccelerators>

    <TitleBar x:Name="AppTitleBar"
              Title="App Store"
              IsBackButtonVisible="False"
              IsPaneToggleButtonVisible="False"
              PaneToggleRequested="AppTitleBar_PaneToggleRequested"
              AutomationProperties.AutomationId="AppTitleBar">
      <TitleBar.IconSource>
        <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico" />
      </TitleBar.IconSource>
    </TitleBar>

    <NavigationView
        x:Name="Nav"
        Grid.Row="1"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsPaneToggleButtonVisible="True"
        PaneDisplayMode="Auto"
        OpenPaneLength="236"
        CompactModeThresholdWidth="641"
        ExpandedModeThresholdWidth="1008"
        IsTitleBarAutoPaddingEnabled="False"
        SelectionChanged="Nav_SelectionChanged"
        DisplayModeChanged="Nav_DisplayModeChanged"
        PaneOpened="Nav_PaneOpened"
        PaneClosed="Nav_PaneClosed"
        AutomationProperties.AutomationId="Nav">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="NavSearch" Content="Search" Tag="search" AutomationProperties.AutomationId="NavSearch" ToolTipService.ToolTip="Search (Ctrl+F)">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE721;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="NavUpdates" Content="Updates" Tag="updates" AutomationProperties.AutomationId="NavUpdates" ToolTipService.ToolTip="Updates">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE895;" /></NavigationViewItem.Icon>
          <NavigationViewItem.InfoBadge>
            <InfoBadge x:Name="UpdatesBadge" Visibility="Collapsed" />
          </NavigationViewItem.InfoBadge>
        </NavigationViewItem>
        <NavigationViewItem x:Name="NavInstalled" Content="Installed" Tag="installed" AutomationProperties.AutomationId="NavInstalled" ToolTipService.ToolTip="Installed">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xF0E2;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="NavQueue" Content="Queue" Tag="queue" AutomationProperties.AutomationId="NavQueue" ToolTipService.ToolTip="Queue">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;" /></NavigationViewItem.Icon>
          <NavigationViewItem.InfoBadge>
            <InfoBadge x:Name="QueueBadge" Visibility="Collapsed" />
          </NavigationViewItem.InfoBadge>
        </NavigationViewItem>
        <NavigationViewItem x:Name="NavHistory" Content="History" Tag="history" AutomationProperties.AutomationId="NavHistory" ToolTipService.ToolTip="History">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem x:Name="NavSettings" Content="Settings" Tag="settings" AutomationProperties.AutomationId="NavSettings" ToolTipService.ToolTip="Settings (Ctrl+,)">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>
      <Frame x:Name="ContentFrame" IsNavigationStackEnabled="False" AutomationProperties.AutomationId="ContentFrame" />
    </NavigationView>

    <!-- Toast: short confirmations, bottom-right -->
    <InfoBar x:Name="Toast"
             Grid.Row="1"
             HorizontalAlignment="Right"
             VerticalAlignment="Bottom"
             MaxWidth="420"
             Margin="24"
             IsClosable="True"
             IsOpen="False"
             Severity="Success"
             AutomationProperties.AutomationId="Toast"
             AutomationProperties.LiveSetting="Polite" />
  </Grid>
</Window>
