<?xml version="1.0" encoding="utf-8"?>
<!-- Style 1 "Clean Windows 11": fixed Windows-blue accent so the app looks the same on every PC. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="SystemAccentColor">#0078D4</Color>
  <Color x:Key="SystemAccentColorLight1">#0093F9</Color>
  <Color x:Key="SystemAccentColorLight2">#60CDFF</Color>
  <Color x:Key="SystemAccentColorLight3">#99EBFF</Color>
  <Color x:Key="SystemAccentColorDark1">#005FB8</Color>
  <Color x:Key="SystemAccentColorDark2">#003E92</Color>
  <Color x:Key="SystemAccentColorDark3">#001968</Color>

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="ChipAccentBackgroundBrush" Color="#E8F1FB" />
      <SolidColorBrush x:Key="ChipAccentForegroundBrush" Color="#005FB8" />
      <SolidColorBrush x:Key="RowSelectedBackgroundBrush" Color="#E8F1FB" />
      <SolidColorBrush x:Key="SkeletonBrush" Color="#E5E5E5" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="ChipAccentBackgroundBrush" Color="#16344A" />
      <SolidColorBrush x:Key="ChipAccentForegroundBrush" Color="#7FD6FF" />
      <SolidColorBrush x:Key="RowSelectedBackgroundBrush" Color="#1F3447" />
      <SolidColorBrush x:Key="SkeletonBrush" Color="#3A3A3A" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="ChipAccentBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="ChipAccentForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="RowSelectedBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="SkeletonBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
