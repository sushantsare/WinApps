<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AppStore.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AppStore"
    NavigationCacheMode="Required">
  <Grid x:Name="PageRoot">
  <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Padding="{StaticResource PagePadding}" HorizontalAlignment="Stretch">
      <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" AutomationProperties.AutomationId="SettingsTitle" Margin="0,0,0,4" />
      <TextBlock Text="Updates" Style="{StaticResource SectionHeaderStyle}" />
      <Grid Style="{StaticResource SettingsCardStyle}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE895;" FontSize="20" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Check for updates when App Store opens" TextWrapping="Wrap" /><TextBlock Text="Results show on the Updates page" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ToggleSwitch IsOn="{x:Bind ViewModel.CheckOnOpen, Mode=TwoWay}" OnContent="On" OffContent="Off" MinWidth="0" AutomationProperties.Name="Check for updates when App Store opens" AutomationProperties.AutomationId="SetCheckOnOpen" /></StackPanel>
      </Grid>
      <Grid Style="{StaticResource SettingsCardStyle}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE7BA;" FontSize="20" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Show held-back major updates" TextWrapping="Wrap" /><TextBlock Text="Listed as “Major update held back” so you can install them yourself" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ToggleSwitch IsOn="{x:Bind ViewModel.ShowHeldMajorUpdates, Mode=TwoWay}" OnContent="On" OffContent="Off" MinWidth="0" AutomationProperties.Name="Show held-back major updates" AutomationProperties.AutomationId="SetShowHeld" /></StackPanel>
      </Grid>
      <Grid Style="{StaticResource SettingsCardStyle}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE8F8;" FontSize="20" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Ignored apps" TextWrapping="Wrap" /><TextBlock Text="{x:Bind ViewModel.IgnoredText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="Show updates again" Command="{x:Bind ViewModel.ShowIgnoredAgainCommand}" AutomationProperties.AutomationId="ShowIgnoredAgain" Visibility="{x:Bind local:X.Vis(ViewModel.HasIgnored), Mode=OneWay}" /></StackPanel>
      </Grid>
      <Grid Style="{StaticResource SettingsCardStyle}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xED1A;" FontSize="20" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Skipped versions" TextWrapping="Wrap" /><TextBlock Text="{x:Bind ViewModel.SkippedText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="Undo all" Command="{x:Bind ViewModel.UndoSkippedCommand}" AutomationProperties.AutomationId="UndoSkipped" Visibility="{x:Bind local:X.Vis(ViewModel.HasSkipped), Mode=OneWay}" /></StackPanel>
      </Grid>
      <TextBlock Text="Installing" Style="{StaticResource SectionHeaderStyle}" />
      <Grid Style="{StaticResource SettingsCardStyle}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE83D;" FontSize="20" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Ask for admin once per batch" TextWrapping="Wrap" /><TextBlock Text="One Windows permission popup for a whole batch. Off: winget asks for each app that needs it." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ToggleSwitch IsOn="{x:Bind ViewModel.AdminOncePerBatch, Mode=TwoWay}" OnContent="On" OffContent="Off" MinWidth="0" AutomationProperties.Name="Ask for admin once per batch" AutomationProperties.AutomationId="SetAdminOnce" /></StackPanel>
      </Grid>
      <Grid Style="{StaticResource SettingsCardStyle}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE896;" FontSize="20" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Install mode" TextWrapping="Wrap" /><TextBlock Text="How installers run" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ComboBox SelectedIndex="{x:Bind ViewModel.InstallModeIndex, Mode=TwoWay}" MinWidth="200" AutomationProperties.Name="Install mode" AutomationProperties.AutomationId="SetInstallMode"><x:String>Silent (recommended)</x:String><x:String>Show installer windows</x:String></ComboBox></StackPanel>
      </Grid>
      <Grid Style="{StaticResource SettingsCardStyle}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE77B;" FontSize="20" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Default install for" TextWrapping="Wrap" /><TextBlock Text="Used unless an app has its own install options" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ComboBox SelectedIndex="{x:Bind ViewModel.DefaultScopeIndex, Mode=TwoWay}" MinWidth="200" AutomationProperties.Name="Default install for" AutomationProperties.AutomationId="SetScope"><x:String>Let the installer decide</x:String><x:String>Just me</x:String><x:String>All users</x:String></ComboBox></StackPanel>
      </Grid>
      <Grid Style="{StaticResource SettingsCardStyle}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE950;" FontSize="20" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Default architecture" TextWrapping="Wrap" /><TextBlock Text="Used unless an app has its own install options" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ComboBox SelectedIndex="{x:Bind ViewModel.DefaultArchitectureIndex, Mode=TwoWay}" MinWidth="200" AutomationProperties.Name="Default architecture" AutomationProperties.AutomationId="SetArch"><x:String>Automatic</x:String><x:String>x64</x:String><x:String>ARM64</x:String></ComboBox></StackPanel>
      </Grid>
      <Grid Style="{StaticResource SettingsCardStyle}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE711;" FontSize="20" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Close apps before updating" TextWrapping="Wrap" /><TextBlock Text="Running apps can make updates fail" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ComboBox SelectedIndex="{x:Bind ViewModel.CloseAppsIndex, Mode=TwoWay}" MinWidth="200" AutomationProperties.Name="Close apps before updating" AutomationProperties.AutomationId="SetCloseApps"><x:String>Ask me</x:String><x:String>Close automatically</x:String><x:String>Never</x:String></ComboBox></StackPanel>
      </Grid>
      <Grid Style="{StaticResource SettingsCardStyle}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE72C;" FontSize="20" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Retry a failed install once automatically" TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ToggleSwitch IsOn="{x:Bind ViewModel.RetryOnce, Mode=TwoWay}" OnContent="On" OffContent="Off" MinWidth="0" AutomationProperties.Name="Retry a failed install once automatically" AutomationProperties.AutomationId="SetRetry" /></StackPanel>
      </Grid>
      <Grid Style="{StaticResource SettingsCardStyle}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE91B;" FontSize="20" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Download icons for search results" TextWrapping="Wrap" /><TextBlock Text="Fetches each app's icon from its website once, then keeps it on this PC" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ToggleSwitch IsOn="{x:Bind ViewModel.DownloadSearchIcons, Mode=TwoWay}" OnContent="On" OffContent="Off" MinWidth="0" AutomationProperties.Name="Download icons for search results" AutomationProperties.AutomationId="SetSearchIcons" /></StackPanel>
      </Grid>
      <TextBlock Text="Start &amp; sidebar" Style="{StaticResource SectionHeaderStyle}" />
      <Grid Style="{StaticResource SettingsCardStyle}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE718;" FontSize="20" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Open on" TextWrapping="Wrap" /><TextBlock Text="First page when App Store starts" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ComboBox SelectedIndex="{x:Bind ViewModel.StartPageIndex, Mode=TwoWay}" MinWidth="200" AutomationProperties.Name="Open on" AutomationProperties.AutomationId="SetStartPage"><x:String>Updates</x:String><x:String>Search</x:String><x:String>Installed</x:String></ComboBox></StackPanel>
      </Grid>
      <Grid Style="{StaticResource SettingsCardStyle}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE700;" FontSize="20" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Sidebar" TextWrapping="Wrap" /><TextBlock Text="The ☰ button switches between names and icons at any time" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ComboBox SelectedIndex="{x:Bind ViewModel.SidebarIndex, Mode=TwoWay}" MinWidth="200" AutomationProperties.Name="Sidebar" AutomationProperties.AutomationId="SetSidebar"><x:String>Remember last</x:String><x:String>Open with names</x:String><x:String>Icons only</x:String></ComboBox></StackPanel>
      </Grid>
      <TextBlock Text="Your app list" Style="{StaticResource SectionHeaderStyle}" />
      <Grid Style="{StaticResource SettingsCardStyle}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xEDE1;" FontSize="20" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Export app list" TextWrapping="Wrap" /><TextBlock Text="Saves your apps and their install options to one file" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="Export…" Command="{x:Bind ViewModel.ExportListCommand}" AutomationProperties.AutomationId="SetExport" /></StackPanel>
      </Grid>
      <Grid Style="{StaticResource SettingsCardStyle}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE8B5;" FontSize="20" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Import app list" TextWrapping="Wrap" /><TextBlock Text="Pick a file, tick what to install" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="Import…" Command="{x:Bind ViewModel.ImportListCommand}" AutomationProperties.AutomationId="SetImport" /></StackPanel>
      </Grid>
      <TextBlock Text="History" Style="{StaticResource SectionHeaderStyle}" />
      <Grid Style="{StaticResource SettingsCardStyle}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE81C;" FontSize="20" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Keep history for" TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ComboBox SelectedIndex="{x:Bind ViewModel.HistoryIndex, Mode=TwoWay}" MinWidth="200" AutomationProperties.Name="Keep history for" AutomationProperties.AutomationId="SetHistoryDays"><x:String>1 year</x:String><x:String>6 months</x:String><x:String>Forever</x:String></ComboBox></StackPanel>
      </Grid>
      <Grid Style="{StaticResource SettingsCardStyle}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE74D;" FontSize="20" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Clear history" TextWrapping="Wrap" /><TextBlock Text="Can’t be undone" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="Clear…" Command="{x:Bind ViewModel.ClearHistoryCommand}" AutomationProperties.AutomationId="ClearHistory" /></StackPanel>
      </Grid>
      <TextBlock Text="winget" Style="{StaticResource SectionHeaderStyle}" />
      <Grid Style="{StaticResource SettingsCardStyle}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE73E;" FontSize="20" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind local:X.Vis(ViewModel.WingetOk), Mode=OneWay}" />
        <FontIcon Glyph="&#xE7BA;" FontSize="20" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind local:X.Vis(ViewModel.WingetBad), Mode=OneWay}" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{x:Bind ViewModel.WingetStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="WingetStatus" /><TextBlock Text="Windows Package Manager, which App Store uses for everything" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" />
          <Button Content="Reset sources" Command="{x:Bind ViewModel.ResetSourcesCommand}" AutomationProperties.AutomationId="ResetSources" />
          <Button Content="Fix winget" Command="{x:Bind ViewModel.FixWingetCommand}" AutomationProperties.AutomationId="SettingsFixWinget" />
        </StackPanel>
      </Grid>
      <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}" />
      <Grid Style="{StaticResource SettingsCardStyle}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE790;" FontSize="20" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="App theme" TextWrapping="Wrap" /><TextBlock Text="Light, Dark or match Windows" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ComboBox SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" MinWidth="200" AutomationProperties.Name="App theme" AutomationProperties.AutomationId="SetTheme"><x:String>Use system setting</x:String><x:String>Light</x:String><x:String>Dark</x:String></ComboBox></StackPanel>
      </Grid>
      <TextBlock Text="About &amp; help" Style="{StaticResource SectionHeaderStyle}" />
      <Grid Style="{StaticResource SettingsCardStyle}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <FontIcon Glyph="&#xE9D9;" FontSize="20" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Diagnostics" TextWrapping="Wrap" /><TextBlock Text="Crash log stays on this PC — nothing is sent anywhere" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="Open log folder" Command="{x:Bind ViewModel.OpenLogFolderCommand}" AutomationProperties.AutomationId="OpenLogs" /></StackPanel>
      </Grid>
      <Grid Style="{StaticResource SettingsCardStyle}" AutomationProperties.AutomationId="AboutCard">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Image Source="ms-appx:///Assets/AppIcon.ico" Width="36" Height="36" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="App Store" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap">
            <Run Text="{x:Bind ViewModel.VersionLine}" /><Run Text=" · Developed by Sushant Kumar · " />
          </TextBlock>
          <HyperlinkButton Padding="0,2" Content="sushant.sare@gmail.com" Command="{x:Bind ViewModel.EmailCommand}" AutomationProperties.AutomationId="EmailLink" />
        </StackPanel>
        <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Click="WhatsNew_Click" AutomationProperties.AutomationId="WhatsNew">
          <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="What's new" /><FontIcon Glyph="&#xE76C;" FontSize="12" /></StackPanel>
        </Button>
      </Grid>
      <Border Height="24" />
    </StackPanel>
  </ScrollViewer>
  </Grid>
</Page>
