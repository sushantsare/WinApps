<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AppStore.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AppStore"
    xmlns:vm="using:AppStore.Core.ViewModels"
    xmlns:c="using:AppStore.Controls"
    NavigationCacheMode="Required">

  <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Padding="32,24,32,24" MaxWidth="1100" HorizontalAlignment="Stretch">
      <Grid ColumnSpacing="16" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="History" Style="{StaticResource PageTitleStyle}" AutomationProperties.AutomationId="HistoryTitle" />
          <TextBlock Text="Everything App Store installed, updated, uninstalled or skipped" Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
          <ComboBox SelectedIndex="{x:Bind ViewModel.ResultFilter, Mode=TwoWay}" MinWidth="140" AutomationProperties.Name="Show results" AutomationProperties.AutomationId="HistoryFilter">
            <x:String>All results</x:String>
            <x:String>Succeeded</x:String>
            <x:String>Failed</x:String>
            <x:String>Skipped or ignored</x:String>
          </ComboBox>
          <Button Command="{x:Bind ViewModel.ExportCommand}" IsEnabled="{x:Bind ViewModel.HasAny, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xEDE1;" FontSize="14" /><TextBlock Text="Export…" /></StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <TextBox PlaceholderText="Filter history" Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               AutomationProperties.Name="Filter history" />

      <StackPanel Spacing="10" Margin="0,80,0,0" HorizontalAlignment="Center" Visibility="{x:Bind local:X.Vis(ViewModel.IsEmpty), Mode=OneWay}">
        <FontIcon Glyph="&#xE81C;" Style="{StaticResource EmptyIconStyle}" />
        <TextBlock HorizontalAlignment="Center" Text="Nothing here yet" Style="{StaticResource SubtitleTextBlockStyle}" />
        <TextBlock HorizontalAlignment="Center" Text="Apps you install, update or uninstall with App Store are listed here." Style="{StaticResource SecondaryTextStyle}" />
      </StackPanel>

      <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}" AutomationProperties.AutomationId="HistoryGroups">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:HistoryGroup">
            <StackPanel>
              <TextBlock Text="{x:Bind Title}" Style="{StaticResource SectionHeaderStyle}" />
              <Border Style="{StaticResource CardStyle}">
                <ItemsControl ItemsSource="{x:Bind}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryRow">
                      <Grid Padding="16,10" ColumnSpacing="12" MinHeight="52" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                            AutomationProperties.Name="{x:Bind local:X.HistoryName(Name, Action, TimeText)}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <c:AppTile PackageId="{x:Bind Id}" PackageName="{x:Bind Name}" TileSize="32" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowTitleStyle}" />
                          <TextBlock Text="{x:Bind Detail}" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <Grid Grid.Column="2">
                          <Border Style="{StaticResource ChipStyle}" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" Visibility="{x:Bind local:X.Vis(IsSuccess)}">
                            <TextBlock Text="{x:Bind Action}" Style="{StaticResource ChipTextStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                          </Border>
                          <Border Style="{StaticResource ChipStyle}" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" Visibility="{x:Bind local:X.Vis(IsFailure)}">
                            <TextBlock Text="{x:Bind Action}" Style="{StaticResource ChipTextStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                          </Border>
                          <Border Style="{StaticResource ChipStyle}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="{x:Bind local:X.Vis(IsInfo)}">
                            <TextBlock Text="{x:Bind Action}" Style="{StaticResource ChipTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                          </Border>
                        </Grid>
                        <TextBlock Grid.Column="3" Text="{x:Bind TimeText}" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</Page>
