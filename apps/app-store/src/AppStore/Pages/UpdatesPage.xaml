<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AppStore.Pages.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AppStore"
    xmlns:m="using:AppStore.Core.Models"
    xmlns:c="using:AppStore.Controls"
    NavigationCacheMode="Required"
    SizeChanged="Page_SizeChanged">

  <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Updates" Style="{StaticResource PageTitleStyle}" AutomationProperties.AutomationId="UpdatesTitle" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ProgressRing Width="14" Height="14" Margin="0,4,0,0" IsActive="True"
                        Visibility="{x:Bind local:X.IsLoading(ViewModel.State), Mode=OneWay}" />
          <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource PageSubtitleStyle}"
                     AutomationProperties.AutomationId="UpdatesSubtitle" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
        <Button AutomationProperties.AutomationId="CheckAgain" AutomationProperties.Name="Check again"
                ToolTipService.ToolTip="Check again (F5)"
                Command="{x:Bind ViewModel.CheckCommand}"
                IsEnabled="{x:Bind local:X.Not(ViewModel.CheckCommand.IsRunning), Mode=OneWay}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE72C;" FontSize="14" />
            <TextBlock x:Name="CheckAgainText" Text="Check again" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource AccentButtonStyle}"
                AutomationProperties.AutomationId="UpdateAll"
                Content="{x:Bind ViewModel.UpdateAllText, Mode=OneWay}"
                ToolTipService.ToolTip="Update the ticked apps (Ctrl+Enter)"
                Command="{x:Bind ViewModel.UpdateAllCommand}"
                IsEnabled="{x:Bind local:X.IsPositive(ViewModel.CheckedCount), Mode=OneWay}">
          <Button.KeyboardAccelerators>
            <KeyboardAccelerator Key="Enter" Modifiers="Control" />
          </Button.KeyboardAccelerators>
        </Button>
      </StackPanel>
    </Grid>

    <!-- winget problem -->
    <InfoBar Grid.Row="1"
             Severity="Error"
             IsClosable="False"
             IsOpen="{x:Bind local:X.IsErrorBool(ViewModel.State), Mode=OneWay}"
             Title="winget isn't working"
             Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
             AutomationProperties.AutomationId="WingetError">
      <InfoBar.ActionButton>
        <Button Content="Fix winget" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="FixWinget"
                Command="{x:Bind ViewModel.FixWingetCommand}" />
      </InfoBar.ActionButton>
    </InfoBar>

    <Grid Grid.Row="2">
      <!-- Checking: skeleton rows -->
      <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top"
              Visibility="{x:Bind local:X.IsLoading(ViewModel.State), Mode=OneWay}"
              AutomationProperties.Name="Checking for updates">
        <StackPanel Padding="16,8">
          <Grid Height="56" ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Rectangle Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="{ThemeResource SkeletonBrush}" />
            <Rectangle Grid.Column="1" Width="36" Height="36" RadiusX="8" RadiusY="8" Fill="{ThemeResource SkeletonBrush}" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="7"><Rectangle Width="180" Height="12" RadiusX="6" RadiusY="6" HorizontalAlignment="Left" Fill="{ThemeResource SkeletonBrush}" /><Rectangle Width="130" Height="10" RadiusX="5" RadiusY="5" HorizontalAlignment="Left" Opacity="0.6" Fill="{ThemeResource SkeletonBrush}" /></StackPanel>
          </Grid>
          <Grid Height="56" ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Rectangle Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="{ThemeResource SkeletonBrush}" />
            <Rectangle Grid.Column="1" Width="36" Height="36" RadiusX="8" RadiusY="8" Fill="{ThemeResource SkeletonBrush}" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="7"><Rectangle Width="140" Height="12" RadiusX="6" RadiusY="6" HorizontalAlignment="Left" Fill="{ThemeResource SkeletonBrush}" /><Rectangle Width="100" Height="10" RadiusX="5" RadiusY="5" HorizontalAlignment="Left" Opacity="0.6" Fill="{ThemeResource SkeletonBrush}" /></StackPanel>
          </Grid>
          <Grid Height="56" ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Rectangle Width="18" Height="18" RadiusX="4" RadiusY="4" Fill="{ThemeResource SkeletonBrush}" />
            <Rectangle Grid.Column="1" Width="36" Height="36" RadiusX="8" RadiusY="8" Fill="{ThemeResource SkeletonBrush}" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="7"><Rectangle Width="200" Height="12" RadiusX="6" RadiusY="6" HorizontalAlignment="Left" Fill="{ThemeResource SkeletonBrush}" /><Rectangle Width="160" Height="10" RadiusX="5" RadiusY="5" HorizontalAlignment="Left" Opacity="0.6" Fill="{ThemeResource SkeletonBrush}" /></StackPanel>
          </Grid>
          <TextBlock Margin="0,8,0,8" Text="You can search for apps while this runs." Style="{StaticResource SecondaryTextStyle}" />
        </StackPanel>
      </Border>

      <!-- All up to date -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="0,0,0,60"
                  Visibility="{x:Bind local:X.IsEmpty(ViewModel.State), Mode=OneWay}"
                  AutomationProperties.AutomationId="UpToDate">
        <Grid Width="72" Height="72" HorizontalAlignment="Center" CornerRadius="36" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
          <FontIcon Glyph="&#xE73E;" FontSize="34" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
        </Grid>
        <TextBlock HorizontalAlignment="Center" Text="All your apps are up to date" Style="{StaticResource SubtitleTextBlockStyle}" />
        <TextBlock HorizontalAlignment="Center" Text="{x:Bind ViewModel.UpToDateText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
          <Button Content="Show skipped" Click="ShowSkipped_Click" />
          <Button Style="{StaticResource AccentButtonStyle}" Click="FindApps_Click">
            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE721;" FontSize="14" /><TextBlock Text="Find new apps" /></StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>

      <!-- winget broken: what Fix winget does -->
      <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top" Padding="20"
              Visibility="{x:Bind local:X.IsError(ViewModel.State), Mode=OneWay}">
        <StackPanel Spacing="8">
          <TextBlock Text="What &quot;Fix winget&quot; does" Style="{StaticResource BodyStrongTextBlockStyle}" />
          <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     Text="1. Sets up Microsoft's WinGet PowerShell module&#x0a;2. Repairs Windows Package Manager (asks for admin once)&#x0a;3. Resets winget's sources and checks again — usually under a minute" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <Button Content="Try again" Command="{x:Bind ViewModel.CheckCommand}" AutomationProperties.AutomationId="TryAgain" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsFixing, Mode=OneWay}" Width="20" Height="20" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Ready: list + details -->
      <Grid x:Name="ReadyGrid" ColumnSpacing="16" Visibility="{x:Bind local:X.IsReady(ViewModel.State), Mode=OneWay}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition x:Name="DetailsColumn" Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="ListPane" RowSpacing="12" Padding="0,0,0,24">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid Padding="16,8" ColumnSpacing="14" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox MinWidth="0" Padding="0" IsChecked="{x:Bind ViewModel.AllChecked, Mode=OneWay}" Click="SelectAll_Click"
                          AutomationProperties.Name="Select all" AutomationProperties.AutomationId="SelectAll" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
              </Grid>
              <ListView x:Name="List" Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Items}"
                        SelectionMode="Single"
                        IsItemClickEnabled="True"
                        ItemClick="List_ItemClick"
                        SelectionChanged="List_SelectionChanged"
                        PreviewKeyDown="List_PreviewKeyDown"
                        ItemContainerStyle="{StaticResource RowListViewItemStyle}"
                        AutomationProperties.Name="Apps with updates"
                        AutomationProperties.AutomationId="UpdatesList">
                <ListView.ItemTemplate>
                  <DataTemplate x:DataType="m:PackageItem">
                    <Grid Height="56" ColumnSpacing="14" AutomationProperties.Name="{x:Bind Name}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="80" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <CheckBox MinWidth="0" Padding="0" VerticalAlignment="Center"
                                IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                IsEnabled="{x:Bind local:X.Not(InQueue), Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind local:X.SelectName(Name)}" />
                      <c:AppTile Grid.Column="1" PackageId="{x:Bind Id}" PackageName="{x:Bind Name}" />
                      <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowTitleStyle}" />
                        <TextBlock Text="{x:Bind Id}" Style="{StaticResource SecondaryTextStyle}" />
                      </StackPanel>
                      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Version}" Style="{StaticResource VersionTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <FontIcon Glyph="&#xE72A;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind Available}" Style="{StaticResource VersionTextStyle}" FontWeight="SemiBold" />
                      </StackPanel>
                      <TextBlock Grid.Column="4" Width="60" TextAlignment="Right" VerticalAlignment="Center"
                                 Text="{x:Bind SizeText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                      <Border Grid.Column="5" Style="{StaticResource ChipStyle}" Visibility="{x:Bind local:X.Vis(InQueue), Mode=OneWay}">
                        <TextBlock Text="In queue" Style="{StaticResource ChipTextStyle}" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Grid>
          </Border>

          <!-- Major updates held back by "Skip major updates" -->
          <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.Held}" AutomationProperties.AutomationId="HeldList">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="m:PackageItem">
                <Border Style="{StaticResource CardStyle}" Padding="16,10" Margin="0,0,0,8">
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <c:AppTile PackageId="{x:Bind Id}" PackageName="{x:Bind Name}" TileSize="28" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                      <Run Text="{x:Bind Name}" FontWeight="SemiBold" />
                      <Run Text="   " />
                      <Run Text="{x:Bind local:X.Arrow(Version, Available)}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </TextBlock>
                    <Border Grid.Column="2" Style="{StaticResource ChipStyle}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                      <TextBlock Text="Major update held back" Style="{StaticResource ChipTextStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Border>
                    <Button Grid.Column="3" Content="Install anyway" Click="InstallHeld_Click" Tag="{x:Bind}"
                            AutomationProperties.Name="{x:Bind local:X.InstallAnywayName(Name)}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>

        <!-- Details -->
        <Grid x:Name="DetailsHost" Grid.Column="1">
        <Border x:Name="DetailsPane" Style="{StaticResource CardStyle}" Width="{StaticResource DetailsWidth}"
                VerticalAlignment="Top" Margin="0,0,0,24"
                Visibility="{x:Bind local:X.HasObj(ViewModel.Selected), Mode=OneWay}"
                AutomationProperties.AutomationId="UpdateDetails" AutomationProperties.Name="App details">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="20" Spacing="14">
              <Button x:Name="DetailsBack" Visibility="Collapsed" Click="DetailsBack_Click" Background="Transparent" BorderThickness="0" Padding="4,4" AutomationProperties.Name="Back to list">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" FontSize="14" /><TextBlock Text="Back" /></StackPanel>
              </Button>
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <c:AppTile PackageId="{x:Bind local:X.Text(ViewModel.Selected.Id), Mode=OneWay}" PackageName="{x:Bind local:X.Text(ViewModel.Selected.Name), Mode=OneWay}" TileSize="48" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind local:X.Text(ViewModel.Selected.Name), Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" TextWrapping="Wrap"
                             AutomationProperties.HeadingLevel="Level2" AutomationProperties.AutomationId="DetailsName" />
                  <TextBlock Text="{x:Bind local:X.Publisher(ViewModel.Details, ViewModel.Selected), Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{x:Bind local:X.Text(ViewModel.Selected.Version), Mode=OneWay}" Style="{StaticResource VersionTextStyle}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <FontIcon Glyph="&#xE72A;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{x:Bind local:X.Text(ViewModel.Selected.Available), Mode=OneWay}" Style="{StaticResource VersionTextStyle}" FontSize="14" FontWeight="SemiBold" />
                <Border Style="{StaticResource ChipStyle}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Margin="6,0,0,0"
                        Visibility="{x:Bind local:X.Has(ViewModel.Selected.SizeText), Mode=OneWay}">
                  <TextBlock Text="{x:Bind local:X.Text(ViewModel.Selected.SizeText), Mode=OneWay}" Style="{StaticResource ChipTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
              </StackPanel>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Content="Update"
                        AutomationProperties.AutomationId="UpdateOne"
                        Command="{x:Bind ViewModel.UpdateOneCommand}" />
                <Button Grid.Column="1" AutomationProperties.AutomationId="SkipVersion" Command="{x:Bind ViewModel.SkipVersionCommand}"
                        ToolTipService.ToolTip="Don't offer this version again (Delete)">
                  <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xED1A;" FontSize="14" /><TextBlock Text="Skip version" /></StackPanel>
                </Button>
              </Grid>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button HorizontalAlignment="Stretch" AutomationProperties.AutomationId="UpdateOptions" Command="{x:Bind ViewModel.EditOptionsCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE9E9;" FontSize="14" /><TextBlock Text="Install options…" /></StackPanel>
                </Button>
                <Button Grid.Column="1" AutomationProperties.AutomationId="IgnoreApp" Command="{x:Bind ViewModel.IgnoreCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8F8;" FontSize="14" /><TextBlock Text="Ignore app" /></StackPanel>
                </Button>
              </Grid>
              <TextBlock Text="{x:Bind local:X.WhatsNewTitle(ViewModel.Selected), Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
              <TextBlock Text="{x:Bind local:X.Notes(ViewModel.Details, ViewModel.DetailsLoading), Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="14" TextTrimming="CharacterEllipsis" />
              <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
              <Grid ColumnSpacing="8" RowSpacing="6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="ID" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Grid.Column="1" Text="{x:Bind local:X.Text(ViewModel.Selected.Id), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Text="Source" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind local:X.Text(ViewModel.Selected.Source), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Grid.Row="2" Text="Installer" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind local:X.Installer(ViewModel.Details), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Grid.Row="3" Text="License" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind local:X.License(ViewModel.Details), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
              </Grid>
              <StackPanel Spacing="2">
                <HyperlinkButton Padding="0,4" NavigateUri="{x:Bind local:X.Homepage(ViewModel.Details), Mode=OneWay}"
                                 Visibility="{x:Bind local:X.HomepageVis(ViewModel.Details), Mode=OneWay}"
                                 Content="{x:Bind local:X.HomepageText(ViewModel.Details), Mode=OneWay}" />
                <HyperlinkButton Padding="0,4" NavigateUri="{x:Bind local:X.NotesUrl(ViewModel.Details), Mode=OneWay}"
                                 Visibility="{x:Bind local:X.NotesVis(ViewModel.Details), Mode=OneWay}"
                                 Content="Release notes" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Page>
