<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AppStore.Pages.QueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AppStore"
    xmlns:s="using:AppStore.Core.Services"
    xmlns:c="using:AppStore.Controls"
    NavigationCacheMode="Required">

  <ScrollViewer>
    <StackPanel Padding="32,24,32,24" MaxWidth="1100" HorizontalAlignment="Stretch">
      <Grid ColumnSpacing="16" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Queue" Style="{StaticResource PageTitleStyle}" AutomationProperties.AutomationId="QueueTitle" />
          <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource PageSubtitleStyle}" AutomationProperties.AutomationId="QueueSubtitle" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
          <Button Command="{x:Bind ViewModel.TogglePauseCommand}" Visibility="{x:Bind local:X.Vis(ViewModel.HasActive), Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE769;" FontSize="14" /><TextBlock Text="{x:Bind ViewModel.PauseText, Mode=OneWay}" /></StackPanel>
          </Button>
          <Button Content="Cancel all" Command="{x:Bind ViewModel.CancelAllCommand}" Visibility="{x:Bind local:X.Vis(ViewModel.HasActive), Mode=OneWay}" />
          <Button Content="Clear finished" Command="{x:Bind ViewModel.ClearFinishedCommand}" Visibility="{x:Bind local:X.Vis(ViewModel.HasFinished), Mode=OneWay}" />
        </StackPanel>
      </Grid>

      <StackPanel Spacing="10" Margin="0,80,0,0" HorizontalAlignment="Center" Visibility="{x:Bind local:X.Vis(ViewModel.IsEmpty), Mode=OneWay}"
                  AutomationProperties.AutomationId="QueueEmpty">
        <FontIcon Glyph="&#xE8FD;" Style="{StaticResource EmptyIconStyle}" />
        <TextBlock HorizontalAlignment="Center" Text="Nothing in the queue" Style="{StaticResource SubtitleTextBlockStyle}" />
        <TextBlock HorizontalAlignment="Center" Text="Updates and installs you start show up here." Style="{StaticResource SecondaryTextStyle}" />
        <Button HorizontalAlignment="Center" Margin="0,6,0,0" Style="{StaticResource AccentButtonStyle}" Content="Go to Updates" Click="GoUpdates_Click" />
      </StackPanel>

      <TextBlock Text="In progress" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,8" Visibility="{x:Bind local:X.Vis(ViewModel.HasActive), Mode=OneWay}" />
      <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind local:X.Vis(ViewModel.HasActive), Mode=OneWay}">
        <ItemsControl ItemsSource="{x:Bind ViewModel.Queue.Active}" AutomationProperties.AutomationId="QueueActive">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="s:OperationItem">
              <Grid Padding="16,10" ColumnSpacing="14" MinHeight="60" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                    AutomationProperties.Name="{x:Bind Name}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:AppTile PackageId="{x:Bind Id}" PackageName="{x:Bind Name}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock TextTrimming="CharacterEllipsis">
                    <Run Text="{x:Bind Name}" FontWeight="SemiBold" />
                    <Run Text="  " />
                    <Run Text="{x:Bind TargetText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12.5" />
                  </TextBlock>
                  <TextBlock Text="{x:Bind Phase, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" AutomationProperties.LiveSetting="Polite" />
                  <ProgressBar Margin="0,6,0,0" Maximum="100"
                               Value="{x:Bind local:X.Percent(Percent), Mode=OneWay}"
                               IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                               Visibility="{x:Bind local:X.Vis(IsRunning), Mode=OneWay}" />
                </StackPanel>
                <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Click="Cancel_Click" Tag="{x:Bind}"
                        ToolTipService.ToolTip="Cancel" AutomationProperties.Name="{x:Bind local:X.CancelName(Name)}">
                  <FontIcon Glyph="&#xE711;" FontSize="14" />
                </Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <TextBlock Text="Finished this session" Style="{StaticResource SectionHeaderStyle}" Visibility="{x:Bind local:X.Vis(ViewModel.HasFinished), Mode=OneWay}" />
      <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind local:X.Vis(ViewModel.HasFinished), Mode=OneWay}">
        <ItemsControl ItemsSource="{x:Bind ViewModel.Queue.Finished}" AutomationProperties.AutomationId="QueueFinished">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="s:OperationItem">
              <Grid Padding="16,10" ColumnSpacing="12" MinHeight="56" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                    AutomationProperties.Name="{x:Bind Name}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:AppTile PackageId="{x:Bind Id}" PackageName="{x:Bind Name}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowTitleStyle}" />
                  <TextBlock Text="{x:Bind Message, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}"
                             Visibility="{x:Bind local:X.NotVis(IsFailed), Mode=OneWay}" />
                  <TextBlock Text="{x:Bind Message, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}"
                             Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                             Visibility="{x:Bind local:X.Vis(IsFailed), Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Border Style="{StaticResource ChipStyle}" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" Visibility="{x:Bind local:X.Vis(IsDone), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                      <TextBlock Text="Done" Style="{StaticResource ChipTextStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    </StackPanel>
                  </Border>
                  <Button Content="Retry" Click="Retry_Click" Tag="{x:Bind}" Visibility="{x:Bind local:X.Vis(IsFailed), Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind local:X.RetryName(Name)}" />
                  <Button Content="Details" Background="Transparent" BorderThickness="0" Click="Details_Click" Tag="{x:Bind}"
                          Visibility="{x:Bind local:X.NotVis(IsDone), Mode=OneWay}" AutomationProperties.Name="{x:Bind local:X.DetailsName(Name)}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
