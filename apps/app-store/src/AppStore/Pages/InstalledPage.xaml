<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AppStore.Pages.InstalledPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AppStore"
    xmlns:m="using:AppStore.Core.Models"
    xmlns:c="using:AppStore.Controls"
    NavigationCacheMode="Required"
    SizeChanged="Page_SizeChanged">

  <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Installed" Style="{StaticResource PageTitleStyle}" AutomationProperties.AutomationId="InstalledTitle" />
        <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource PageSubtitleStyle}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
        <ComboBox SelectedIndex="{x:Bind ViewModel.SourceFilter, Mode=TwoWay}" MinWidth="150"
                  AutomationProperties.Name="Show apps from" AutomationProperties.AutomationId="SourceFilter">
          <x:String>All sources</x:String>
          <x:String>winget</x:String>
          <x:String>Not from winget</x:String>
        </ComboBox>
        <Button Command="{x:Bind ViewModel.LoadCommand}" AutomationProperties.Name="Refresh" ToolTipService.ToolTip="Refresh (F5)">
          <FontIcon Glyph="&#xE72C;" FontSize="14" />
        </Button>
        <Button Command="{x:Bind ViewModel.ExportCommand}" AutomationProperties.AutomationId="ExportList">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xEDE1;" FontSize="14" /><TextBlock x:Name="ExportText" Text="Export list" /></StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <TextBox Grid.Row="1" PlaceholderText="Filter installed apps"
             Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             AutomationProperties.Name="Filter installed apps" AutomationProperties.AutomationId="InstalledFilter" />

    <Grid Grid.Row="2">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0" Spacing="12"
                  Visibility="{x:Bind local:X.IsLoading(ViewModel.State), Mode=OneWay}">
        <ProgressRing IsActive="True" Width="32" Height="32" />
        <TextBlock Text="Reading installed apps…" Style="{StaticResource SecondaryTextStyle}" />
      </StackPanel>

      <InfoBar VerticalAlignment="Top" Severity="Error" IsClosable="False" Title="Couldn't read installed apps"
               IsOpen="{x:Bind local:X.IsErrorBool(ViewModel.State), Mode=OneWay}" Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}">
        <InfoBar.ActionButton>
          <Button Content="Try again" Command="{x:Bind ViewModel.LoadCommand}" />
        </InfoBar.ActionButton>
      </InfoBar>

      <Grid ColumnSpacing="16" Visibility="{x:Bind local:X.IsReady(ViewModel.State), Mode=OneWay}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="ListPane" RowSpacing="12" Padding="0,0,0,24">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
            <ListView x:Name="List"
                      ItemsSource="{x:Bind ViewModel.Visible}"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="List_ItemClick"
                      SelectionChanged="List_SelectionChanged"
                      PreviewKeyDown="List_PreviewKeyDown"
                      ItemContainerStyle="{StaticResource RowListViewItemStyle}"
                      AutomationProperties.Name="Installed apps"
                      AutomationProperties.AutomationId="InstalledList">
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:PackageItem">
                  <Grid Height="56" ColumnSpacing="14" AutomationProperties.Name="{x:Bind Name}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" MinWidth="80" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox MinWidth="0" Padding="0" VerticalAlignment="Center"
                              IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                              IsEnabled="{x:Bind local:X.Not(InQueue), Mode=OneWay}"
                              AutomationProperties.Name="{x:Bind local:X.SelectName(Name)}" />
                    <c:AppTile Grid.Column="1" PackageId="{x:Bind Id}" PackageName="{x:Bind Name}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                      <TextBlock Text="{x:Bind Name}" Style="{StaticResource RowTitleStyle}" />
                      <TextBlock Text="{x:Bind Id}" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <Border Grid.Column="3" Style="{StaticResource ChipStyle}" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            Visibility="{x:Bind local:X.Has(Tag), Mode=OneWay}">
                      <TextBlock Text="{x:Bind Tag, Mode=OneWay}" Style="{StaticResource ChipTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <TextBlock Grid.Column="4" MinWidth="80" TextAlignment="Right" Text="{x:Bind Version}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                    <Grid Grid.Column="5" Width="104">
                      <TextBlock Text="{x:Bind SourceText}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"
                                 Visibility="{x:Bind local:X.NotVis(InQueue), Mode=OneWay}" />
                      <Border Style="{StaticResource ChipStyle}" HorizontalAlignment="Left" Visibility="{x:Bind local:X.Vis(InQueue), Mode=OneWay}">
                        <TextBlock Text="In queue" Style="{StaticResource ChipTextStyle}" />
                      </Border>
                    </Grid>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Border>
          <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16,10"
                  Visibility="{x:Bind local:X.Positive(ViewModel.CheckedCount), Mode=OneWay}">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.SelectedText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind ViewModel.CheckedNames, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
              <Button Grid.Column="2" Content="Clear" Background="Transparent" BorderThickness="0" Command="{x:Bind ViewModel.ClearSelectionCommand}" />
              <Button Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.UninstallSelectedCommand}" AutomationProperties.AutomationId="UninstallSelected">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontSize="14" /><TextBlock Text="{x:Bind ViewModel.UninstallSelectedText, Mode=OneWay}" /></StackPanel>
              </Button>
            </Grid>
          </Border>
        </Grid>

        <Grid x:Name="DetailsHost" Grid.Column="1">
          <Border x:Name="DetailsPane" Style="{StaticResource CardStyle}" Width="{StaticResource DetailsWidth}" VerticalAlignment="Top" Margin="0,0,0,24"
                  Visibility="{x:Bind local:X.HasObj(ViewModel.Selected), Mode=OneWay}"
                  AutomationProperties.AutomationId="InstalledDetails" AutomationProperties.Name="App details">
            <StackPanel Padding="20" Spacing="14">
              <Button x:Name="DetailsBack" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="4,4" AutomationProperties.Name="Back to list">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" FontSize="14" /><TextBlock Text="Back" /></StackPanel>
              </Button>
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <c:AppTile PackageId="{x:Bind local:X.Text(ViewModel.Selected.Id), Mode=OneWay}" PackageName="{x:Bind local:X.Text(ViewModel.Selected.Name), Mode=OneWay}" TileSize="48" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind local:X.Text(ViewModel.Selected.Name), Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
                  <TextBlock Text="{x:Bind local:X.VersionAndSource(ViewModel.Selected), Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
              </Grid>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.EditOptionsCommand}" AutomationProperties.AutomationId="InstalledOptions"
                        IsEnabled="{x:Bind local:X.FromWinget(ViewModel.Selected), Mode=OneWay}">
                  <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE9E9;" FontSize="14" /><TextBlock Text="Install options…" /></StackPanel>
                </Button>
                <Button Grid.Column="1" Command="{x:Bind ViewModel.UninstallOneCommand}" AutomationProperties.AutomationId="UninstallOne">
                  <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontSize="14" /><TextBlock Text="Uninstall" /></StackPanel>
                </Button>
              </Grid>
              <TextBlock Text="Saved options" Style="{StaticResource BodyStrongTextBlockStyle}" Visibility="{x:Bind local:X.VisWinget(ViewModel.Selected), Mode=OneWay}" />
              <Grid ColumnSpacing="8" RowSpacing="6" Visibility="{x:Bind local:X.VisWinget(ViewModel.Selected), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="Install for" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Grid.Column="1" Text="{x:Bind local:X.ScopeText(ViewModel.SelectedOptions), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Grid.Row="1" Text="Architecture" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind local:X.ArchText(ViewModel.SelectedOptions), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Grid.Row="2" Text="Updates" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind local:X.UpdatesText(ViewModel.SelectedOptions), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Grid.Row="3" Text="Close first" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind local:X.CloseText(ViewModel.SelectedOptions), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
              </Grid>
              <TextBlock TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Visibility="{x:Bind local:X.VisNotWinget(ViewModel.Selected), Mode=OneWay}"
                         Text="This app isn't managed by winget. You can uninstall it here, but App Store can't update it." />
              <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
              <Grid ColumnSpacing="8" RowSpacing="6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="ID" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Grid.Column="1" Text="{x:Bind local:X.Text(ViewModel.Selected.Id), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Text="Source" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind local:X.Text(ViewModel.Selected.SourceText), Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Page>
